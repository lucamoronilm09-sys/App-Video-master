# Variabili d'ambiente per AI Video Maker

# ===========================================
# BACKEND CONFIGURATION
# ===========================================

# Host e porta del backend
HOST=0.0.0.0
PORT=8000

# Vision AI Provider (auto, openai, disabled)
VISION_PROVIDER=auto

# Endpoint OpenAI-compatible (opzionale)
# VISION_BASE_URL=https://tuo-endpoint/v1
# VISION_MODEL=tuo-modello-vision
# VISION_API_KEY=...

# Google Drive OAuth (opzionale)
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# Directory per i dati dei progetti
DATA_DIR=/app/data

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================

# Ambiente Node.js
NODE_ENV=development

# URL dell'API backend (per il frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Porta del frontend
PORT=3000
HOSTNAME=0.0.0.0
