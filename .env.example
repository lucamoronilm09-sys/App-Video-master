# Variabili d'ambiente per AI Video Maker
# Copia questo file in .env e personalizza i valori per il tuo ambiente.
# NON committare mai il file .env nel repository.

# ===========================================
# AMBIENTE (development, testing, staging, production)
# ===========================================
# Determina il comportamento dell'applicazione
APP_ENV=development

# ===========================================
# BACKEND CONFIGURATION
# ===========================================

# Host e porta del backend
HOST=0.0.0.0
PORT=8000

# Vision AI Provider (auto, openai, ollama, disabled)
VISION_PROVIDER=auto

# Configurazione OpenAI-compatible (opzionale)
# VISION_BASE_URL=https://tuo-endpoint/v1
# VISION_MODEL=tuo-modello-vision
# VISION_API_KEY=...

# Timeout per le chiamate Vision AI (secondi)
VISION_TIMEOUT_SEC=45

# Ollama URL locale (se VISION_PROVIDER=ollama)
# OLLAMA_URL=http://host.docker.internal:11434

# Google Drive OAuth (opzionale)
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# Directory per i dati dei progetti (interno container)
DATA_DIR=/app/data

# ===========================================
# SICUREZZA
# ===========================================

# API Key per autenticazione (opzionale, richiesta se impostata)
# API_KEY=la-tua-api-key-segreta

# CORS Origins consentiti (separati da virgola)
# Development default: http://localhost:3000,http://127.0.0.1:3000
# Production: imposta i tuoi domini
# CORS_ORIGINS=https://app.example.com,https://video.example.com

# Regex per origini CORS dinamiche (opzionale)
# CORS_ORIGIN_REGEX=^https://.*\.example\.com$

# ===========================================
# LOGGING
# ===========================================

# Livello di log: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Usare DEBUG solo in development/testing
LOG_LEVEL=INFO

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================

# Ambiente Node.js (NON modificare manualmente, gestito da docker-compose)
# NODE_ENV=development

# URL dell'API backend (per il frontend)
# Development: http://localhost:8000
# Docker: http://backend:8000
# Production: https://api.example.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Porta del frontend
PORT=3000
HOSTNAME=0.0.0.0

# Backend URL per il proxy API (Next.js server-side)
# Se non impostato, usa NEXT_PUBLIC_API_URL o default
# BACKEND_URL=http://localhost:8000

# ===========================================
# RATE LIMITING
# ===========================================

# Richieste al minuto per IP (default FastAPI/SlowAPI)
# RATE_LIMIT_PER_MINUTE=60

# ===========================================
# PRODUZIONE (solo per ambiente production)
# ===========================================

# Numero di worker uvicorn (production)
# UVICORN_WORKERS=4

# Resource limits (da configurare in docker-compose.production.yml)
# MEMORY_LIMIT=2G
# CPU_LIMIT=2.0
