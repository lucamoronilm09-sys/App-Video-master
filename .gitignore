```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Python virtual environments
venv/
.venv/
env/

# Tests cache
.pytest_cache/
.coverage
coverage/

# Logs
*.log

# Temporary files
*.tmp
*.swp
*.swo

# Environment files
.env
.env.local
*.env.*

# OS generated files
.DS_Store
Thumbs.db

# Build artifacts
build/
dist/
*.egg-info/
```